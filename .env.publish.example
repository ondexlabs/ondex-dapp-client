# Copy this file to .env.publish for local publishing.
# Do not commit .env.publish.

# npm token with permission to publish packages under the @ondex org.
NPM_TOKEN=replace_with_npm_publish_token

# Use the publish-only npm config after this file is sourced from the SDK dir.
NPM_CONFIG_USERCONFIG=.npmrc.publish

# Optional. Only needed if you use the GitHub CLI in a non-interactive shell.
# Prefer `gh auth login` locally or GitHub Actions secrets in CI.
GH_TOKEN=replace_with_github_token
