{
  "name": "@ondex/dapp-client",
  "version": "0.3.0",
  "description": "Public TypeScript helpers for connecting XRPL dApps to Ondex.",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ondexlabs/ondex-dapp-client.git"
  },
  "bugs": {
    "url": "https://github.com/ondexlabs/ondex-dapp-client/issues"
  },
  "homepage": "https://github.com/ondexlabs/ondex-dapp-client#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.mjs",
    "lint": "tsc --noEmit -p tsconfig.json",
    "example:x402-merchant": "node examples/x402-merchant.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run lint && pnpm test"
  },
  "keywords": [
    "ondex",
    "xrpl",
    "walletconnect",
    "xrp",
    "dapp"
  ],
  "license": "MIT",
  "devDependencies": {
    "@hono/node-server": "2.0.12",
    "@x402/core": "2.21.0",
    "@x402/hono": "2.21.0",
    "@x402/xrpl": "2.21.0",
    "hono": "4.12.30",
    "typescript": "^5.6.0"
  }
}
